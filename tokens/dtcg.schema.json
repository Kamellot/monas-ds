{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monas.dev/schemas/dtcg.schema.json",
  "title": "Monas W3C DTCG Design Tokens Schema",
  "description": "JSON Schema validating W3C Design Tokens Community Group (DTCG) format files with Monas multi-theme and 3-tier cascade extensions.",
  "type": "object",
  "$defs": {
    "tokenType": {
      "type": "string",
      "enum": [
        "color",
        "dimension",
        "fontFamily",
        "fontWeight",
        "duration",
        "cubicBezier",
        "number",
        "strokeStyle",
        "border",
        "transition",
        "shadow",
        "gradient",
        "typography"
      ]
    },
    "aliasReference": {
      "type": "string",
      "pattern": "^\\{[a-zA-Z0-9._-]+\\}$",
      "description": "W3C DTCG alias reference syntax pointing to another token path, e.g., '{colors.gray.900}'."
    },
    "typographyValue": {
      "type": "object",
      "properties": {
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "string" },
        "fontWeight": { "type": ["string", "number"] },
        "letterSpacing": { "type": "string" },
        "lineHeight": { "type": ["string", "number"] }
      },
      "required": ["fontFamily", "fontSize", "fontWeight", "lineHeight"],
      "additionalProperties": false
    },
    "shadowObject": {
      "type": "object",
      "properties": {
        "color": { "type": "string" },
        "offsetX": { "type": "string" },
        "offsetY": { "type": "string" },
        "blur": { "type": "string" },
        "spread": { "type": "string" },
        "inset": { "type": "boolean" }
      },
      "required": ["color", "offsetX", "offsetY", "blur", "spread"],
      "additionalProperties": false
    },
    "borderValue": {
      "type": "object",
      "properties": {
        "color": { "type": "string" },
        "width": { "type": "string" },
        "style": { "type": "string" }
      },
      "required": ["color", "width", "style"],
      "additionalProperties": false
    },
    "tokenValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "$ref": "#/$defs/shadowObject" }
            ]
          }
        },
        { "$ref": "#/$defs/typographyValue" },
        { "$ref": "#/$defs/shadowObject" },
        { "$ref": "#/$defs/borderValue" }
      ]
    },
    "monasExtension": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["primitive", "semantic", "component"],
          "description": "Defines the cascade tier in the Monas token architecture."
        },
        "conditions": {
          "type": "object",
          "description": "Multi-theme conditional values mapped to PandaCSS conditions (e.g., default, _dark, _ocean).",
          "propertyNames": {
            "pattern": "^(default|_[a-zA-Z0-9_-]+)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/tokenValue"
          }
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "properties": {
        "com.monas": {
          "$ref": "#/$defs/monasExtension"
        }
      },
      "additionalProperties": true
    },
    "tokenNode": {
      "type": "object",
      "properties": {
        "$value": { "$ref": "#/$defs/tokenValue" },
        "$type": { "$ref": "#/$defs/tokenType" },
        "$description": { "type": "string" },
        "$extensions": { "$ref": "#/$defs/extensions" }
      },
      "required": ["$value"],
      "additionalProperties": false
    },
    "tokenGroup": {
      "type": "object",
      "properties": {
        "$schema": { "type": "string" },
        "$type": { "$ref": "#/$defs/tokenType" },
        "$description": { "type": "string" },
        "$extensions": { "$ref": "#/$defs/extensions" }
      },
      "patternProperties": {
        "^[^$][a-zA-Z0-9_-]*$": {
          "oneOf": [
            { "$ref": "#/$defs/tokenNode" },
            { "$ref": "#/$defs/tokenGroup" }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/tokenGroup"
}

