          "com.monas": {
            "conditions": {
              "default": "{colors.cyan.500}",
              "_light": "{colors.cyan.500}",
              "_dark": "{colors.cyan.400}"
            }
          }
        }
      },
      "inverse": {
        "$value": "{colors.white}",
        "$description": "Ocean foreground text on inverse surfaces",
        "$extensions": {
          "com.monas": {
            "conditions": {
              "default": "{colors.white}",
              "_light": "{colors.white}",
              "_dark": "{colors.cyan.950}"
