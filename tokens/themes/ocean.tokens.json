{
  "$schema": "../dtcg.schema.json",
  "$description": "Monas Design System Optional Theme: Ocean (Light & Dark)",
  "$extensions": {
    "com.monas": {
      "tier": "semantic"
    }
  },
  "colors": {
    "$type": "color",
    "$description": "Ocean theme semantic color tokens with light and dark mode variants",
    "bg": {
      "canvas": {
        "$value": "{colors.cyan.50}",
        "$description": "Ocean page canvas background surface",
        "$extensions": {
          "com.monas": {
            "conditions": {
              "default": "{colors.cyan.50}",
              "_light": "{colors.cyan.50}",
              "_dark": "{colors.cyan.950}"
            }
          }
        }
      },
      "surface": {
        "$value": "{colors.white}",
        "$description": "Ocean elevated card and container surface",
        "$extensions": {
          "com.monas": {
            "conditions": {
              "default": "{colors.white}",
              "_light": "{colors.white}",
              "_dark": "{colors.cyan.900}"
            }
          }
        }
      },
      "subtle": {
        "$value": "{colors.cyan.100}",
        "$description": "Ocean subtle secondary container background",
        "$extensions": {
          "com.monas": {
            "conditions": {
              "default": "{colors.cyan.100}",
              "_light": "{colors.cyan.100}",
              "_dark": "{colors.cyan.800}"
            }
          }
        }
      },
      "muted": {
        "$value": "{colors.cyan.200}",
        "$description": "Ocean muted interactive or well surface",
        "$extensions": {
          "com.monas": {
            "conditions": {
              "default": "{colors.cyan.200}",
              "_light": "{colors.cyan.200}",
              "_dark": "{colors.cyan.700}"
            }
          }
        }
      },
      "inverse": {
        "$value": "{colors.cyan.950}",
        "$description": "Ocean high-contrast inverse surface",
        "$extensions": {
          "com.monas": {
            "conditions": {
              "default": "{colors.cyan.950}",
              "_light": "{colors.cyan.950}",
              "_dark": "{colors.cyan.50}"
            }
          }
        }
      }
    },
    "text": {
      "DEFAULT": {
        "$value": "{colors.cyan.950}",
        "$description": "Ocean primary body and heading text color",
        "$extensions": {
          "com.monas": {
            "conditions": {
              "default": "{colors.cyan.950}",
              "_light": "{colors.cyan.950}",
              "_dark": "{colors.cyan.50}"
            }
          }
        }
      },
      "muted": {
        "$value": "{colors.cyan.700}",
        "$description": "Ocean secondary supporting text color",
        "$extensions": {
          "com.monas": {
            "conditions": {
              "default": "{colors.cyan.700}",
              "_light": "{colors.cyan.700}",
              "_dark": "{colors.cyan.200}"
            }
          }
        }
      },
      "subtle": {
        "$value": "{colors.cyan.500}",
